# Editor defaults for tracked text files: encoding, line endings, final newline,
# indentation and trailing whitespace. Formatters and linters keep their own
# configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{sh,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,ts,tsx,js,json,jsonc}]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown, so trimming them
# changes what the page renders.
[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 80

# Generated or free-form prose. Wrapping is not enforced on these.
[{CHANGELOG.md,changelog.d/**.md}]
max_line_length = off

# Raw fuzz inputs are bytes. Re-encoding, converting line endings, trimming or
# appending a newline all change the input.
[fuzz/corpus/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
