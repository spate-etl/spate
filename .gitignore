/target
**/target
*.profraw
.DS_Store
/.claude/*
!/.claude/commands/
!/.claude/skills/

# Credentials. Nothing here has ever been committed and push protection is on,
# but neither of those helps somebody who drops a local .env next to a compose
# file and runs `git add -A`. This is the net under that.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.netrc
credentials
secrets/

# Docusaurus docs site (website/)
website/node_modules
website/build
website/.docusaurus
website/.cache-loader
# Generated rustdoc, staged into the site by the scheduled deploy (see .github/workflows/scheduled.yml)
website/static/api
# Generated third-party licence texts, staged into the site by the same workflow.
# The compact, diffable inventory (THIRD-PARTY.md) IS committed; only the
# 300KB full-text render is rebuilt per deploy.
website/static/licenses
npm-debug.log*
yarn-error.log
