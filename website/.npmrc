# Do not run dependency lifecycle scripts on install.
#
# This covers this project's own `npm ci` and nothing else. The `docs-deploy`
# job in .github/workflows/scheduled.yml runs a second npm install
# (cloudflare/wrangler-action shells out to `npm i wrangler@3.x`) with no
# checkout, so this file is not on disk there; that step sets
# NPM_CONFIG_IGNORE_SCRIPTS instead. Assume another npm install added anywhere
# is uncovered until you have checked it.
#
# List the packages declaring an install script with:
#   jq -r '.packages | to_entries[]
#          | select(.value.hasInstallScript == true) | .key' package-lock.json
#
# If a future dependency needs its install script, prefer replacing the
# dependency over deleting this line.
ignore-scripts=true

# `minimumReleaseAge` does not belong here. npm 11.9 does not recognise the key,
# and `npm ci` reads the committed lockfile without resolving, so a release-age
# floor never fires. The cooldown on entry into this lockfile is the
# `cooldown:` block for the npm ecosystem in .github/dependabot.yml.
