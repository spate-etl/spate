# Do not run dependency lifecycle scripts on install.
#
# This covers this project's own `npm ci` and nothing else. An npm install run
# without a checkout of this file is uncovered, and sets
# NPM_CONFIG_IGNORE_SCRIPTS itself; assume any npm install added anywhere is
# uncovered until you have checked it.
#
# If a future dependency needs its install script, prefer replacing the
# dependency over deleting this line.
ignore-scripts=true

# `minimumReleaseAge` here is inert: npm 11.9 does not recognize the key, and
# `npm ci` reads the committed lockfile without resolving. The cooldown on entry
# into this lockfile is the `cooldown:` block for the npm ecosystem in
# .github/dependabot.yml.
