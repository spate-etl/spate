// The documentation site as a Cloudflare Worker serving static assets. The
// deploy job runs this from the build artifact without a checkout; keep it
// self-contained.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "spate",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./build",
    // Docusaurus builds with `trailingSlash: false`, so a page is `foo.html`
    // and a directory index is `foo/index.html`; this serves both at `/foo`.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "spate.kainth.dev", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
